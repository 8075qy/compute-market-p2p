# 后端控制面地址（含 /api/v1）
API_BASE_URL=http://localhost:8000/api/v1

# 供给方账号（需先在平台注册，Agent 用其登录）
AGENT_CONTACT=supplier@example.com
AGENT_PASSWORD=your-password

# 已注册节点 ID，留空则由 Agent 自动注册新节点
NODE_ID=

# 节点硬件信息（自动注册时使用）
# GPU_MODEL / VRAM_GB 优先用 Agent 实测值（nvidia-smi / rocm-smi / system_profiler）
# PEAK_TFLOPS 优先按实测型号匹配 GPU 规格库自动填充
# 以下仅为实测/匹配不到时的兜底值，通常无需修改
NODE_NAME=agent-node-01
GPU_MODEL=RTX 3080
VRAM_GB=10
PEAK_TFLOPS=30

# 调度参数
HEARTBEAT_INTERVAL=30
POLL_INTERVAL=5

# 本地工作目录（模型缓存 + 结果暂存）
WORK_DIR=./data