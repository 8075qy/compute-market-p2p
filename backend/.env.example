# ===== 后端环境变量模板 =====
# 复制为 .env 后按需修改；本地开发默认连接 Homebrew 启动的 PostgreSQL/Redis/MinIO

APP_NAME=ComputeMarketP2P
APP_VERSION=0.1.0
DEBUG=true

# 数据库（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://dev:dev@localhost:5432/compute_market_p2p

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=compute-market-p2p
MINIO_SECURE=false

# JWT（生产环境务必更换为随机密钥，长度 >= 32）
JWT_SECRET=dev-secret-change-in-production-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 允许来源（JSON 数组）
# CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]